# InsideJob API credentials. Copy to `.env` and fill in. Never commit `.env`.
#
# Only the generated-policy study (`python -m policy_corpus`) reads this file.
# The audit itself (`python -m gapfuzz`, `pytest`) needs no key.
#
# Groq's free tier has no card attached: exceeding a limit returns HTTP 429, it
# does not bill you. The client paces itself to stay under the limits and stops
# cleanly on a per-day cap.

# Groq (free tier)
# keys: https://console.groq.com/keys    limits: https://console.groq.com/settings/limits
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google AI Studio (optional, unused by default). This is the AI Studio key,
# not Vertex AI / GCP.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Models are passed on the command line, for example:
#   python -m policy_corpus generate --model groq:openai/gpt-oss-120b --suite slack
#   python -m policy_corpus generate --model groq:qwen/qwen3.8-27b   --suite slack

# Free-tier pacing. Tokens per minute is the binding limit, not requests: a
# policy-generation prompt carries a few thousand tokens of tool schema. Set
# both a little under the real cap.
GROQ_RPM=28
GROQ_TPM=7000

# Per-model overrides win over the provider-wide setting above, e.g.:
#   INSIDEJOB_TPM_OPENAI_GPT_OSS_120B=7000

GEMINI_RPM=8
GEMINI_TPM=200000
