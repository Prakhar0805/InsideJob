# InsideJob — API credentials. Copy to `.env` and fill in. NEVER commit `.env`.
#
# Cost ceiling for this project is $0: both providers below are used on their
# free tiers only. See CLAUDE.md §6.

# --- Groq (free tier, open-weight models) -----------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Google AI Studio (free tier, closed Gemini models) ---------------------
# https://aistudio.google.com/apikey
# NOTE: this is the AI Studio key, NOT Vertex AI / GCP. We use Google's
# OpenAI-compatible endpoint so no GCP project or billing account is needed.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Role assignment --------------------------------------------------------
# Which model plays the agent (the victim) and which plays the attacker.
# CLAUDE.md §5 requires these to be *different provider/model families* so an
# attacker blind spot cannot be correlated with an agent blind spot.
INSIDEJOB_AGENT_MODEL=groq:llama-3.3-70b-versatile
INSIDEJOB_ATTACKER_MODEL=gemini:gemini-2.5-flash

# Progent generates its policies with an LLM. Keep this on the *agent's*
# provider: the policy engine is part of the system under test, not part of
# the attack, so it must not borrow the attacker's model.
INSIDEJOB_POLICY_MODEL=groq:llama-3.3-70b-versatile

# --- Free-tier throttling ---------------------------------------------------
# Requests per minute budget per provider. Set below the published free-tier
# limit; the harness sleeps rather than burning retries on 429s.
GROQ_RPM=25
GEMINI_RPM=8
