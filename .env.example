# InsideJob — API credentials. Copy to `.env` and fill in. NEVER commit `.env`.
#
# Cost ceiling is $0 (CLAUDE.md §6). Groq's free tier has no card attached:
# exceeding a limit returns HTTP 429, it does not bill you. The harness paces
# itself to stay under the limits and stops cleanly on a per-day cap.

# --- Groq (free tier) -------------------------------------------------------
# https://console.groq.com/keys      limits: https://console.groq.com/settings/limits
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Google AI Studio -------------------------------------------------------
# UNUSED — the project is Groq-only for now. Kept configured so the Gemini arm
# can be switched back on without code changes. This is the AI Studio key, NOT
# Vertex AI / GCP.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Role assignment --------------------------------------------------------
# CLAUDE.md §5 requires the attacker to be a different model FAMILY from the
# agent, so their blind spots cannot be correlated. The harness enforces that
# (src/config.py: infer_family) and prints a caveat when both share a provider.
#
# Chosen for the observed free-tier model list. Each model has its OWN quota
# bucket, so splitting the three roles across three models triples the budget:
#
#   agent   openai/gpt-oss-120b   family gpt-oss   30 RPM / 1K RPD / 8K TPM / 200K TPD
#   attacker qwen/qwen3.6-27b     family qwen      30 RPM / 1K RPD / 8K TPM / 200K TPD
#   policy  openai/gpt-oss-20b    family gpt-oss   30 RPM / 1K RPD / 8K TPM / 200K TPD
#
# Agent and policy sharing a family is fine and matches Progent's own run.sh,
# which uses one model for both. Only policy-vs-attacker must differ.
INSIDEJOB_AGENT_MODEL=groq:openai/gpt-oss-120b
INSIDEJOB_ATTACKER_MODEL=groq:qwen/qwen3.6-27b
INSIDEJOB_POLICY_MODEL=groq:openai/gpt-oss-20b

# --- Free-tier pacing -------------------------------------------------------
# TOKENS per minute is the binding limit, not requests: one AgentDojo agent call
# carries 1k-4k tokens of tool schema, so 8K TPM allows only a handful of calls
# per minute while 30 RPM is never reached. Set both a little under the real cap.
GROQ_RPM=28
GROQ_TPM=7000

# Per-model overrides win over the provider-wide setting above, e.g.:
#   INSIDEJOB_TPM_OPENAI_GPT_OSS_120B=7000
#   INSIDEJOB_RPM_QWEN_QWEN3_6_27B=28

GEMINI_RPM=8
GEMINI_TPM=200000
