# InsideJob — API credentials. Copy to `.env` and fill in. NEVER commit `.env`.
#
# Cost ceiling for this project is $0: every provider below is used on its free
# tier only. See CLAUDE.md §6.

# --- Groq (free tier, open-weight models) -----------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Google AI Studio (free tier, closed Gemini models) ---------------------
# Currently UNUSED — the project is running Groq-only for now. Kept configured
# so the Gemini arm can be switched back on without code changes.
# https://aistudio.google.com/apikey
# NOTE: this is the AI Studio key, NOT Vertex AI / GCP. We use Google's
# OpenAI-compatible endpoint so no GCP project or billing account is needed.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Role assignment --------------------------------------------------------
# Which model plays the agent (the victim) and which plays the attacker.
#
# CLAUDE.md §5 requires these to be different provider/MODEL FAMILIES so an
# attacker blind spot cannot be correlated with an agent blind spot. The
# harness enforces the *family* half of that (src/config.py: infer_family) —
# family is what the correlated-failure argument actually rests on. Running
# both roles on one provider is allowed but is weaker separation than §5's
# ideal; every run prints that caveat, and it must appear in the write-up.
#
# Groq hosts several unrelated families, so a Groq-only setup can still be
# family-separated:
#   agent llama-*  +  attacker openai/gpt-oss-*  or  moonshotai/kimi-k2-*
INSIDEJOB_AGENT_MODEL=groq:llama-3.3-70b-versatile
INSIDEJOB_ATTACKER_MODEL=groq:openai/gpt-oss-120b

# Alternative attacker if gpt-oss refuses too many red-team generations — watch
# the `atkfail` column in the results table; a high rate means the measured ASR
# is a lower bound on the attack, not evidence the defence is strong:
#   INSIDEJOB_ATTACKER_MODEL=groq:moonshotai/kimi-k2-instruct

# Progent generates its policies with an LLM. Keep this on the *agent's* side:
# the policy engine is part of the system under test, not part of the attack,
# so it must not share a family with the attacker (enforced).
INSIDEJOB_POLICY_MODEL=groq:llama-3.3-70b-versatile

# --- Free-tier throttling ---------------------------------------------------
# Requests per minute budget per provider. Set below the published free-tier
# limit; the harness sleeps rather than burning retries on 429s.
#
# NOTE: with both roles plus the policy model on one Groq key, all three share
# this single budget. Lower it if you see sustained 429s.
GROQ_RPM=25
GEMINI_RPM=8
